{
  "schema": 1,
  "repository": "victron-venus/inverter-control",
  "mode": "release",
  "default_branch": "main",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "release-security.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "version_file": "version",
  "local_checks": [
    "bash scripts/ci.sh",
    "bash scripts/ci.sh integration",
    "bash scripts/ci.sh security"
  ],
  "notes": [
    "Native Venus OS Python/D-Bus and hardware tests require a separate target acceptance run. Existing integration job checks shared mocks."
  ],
  "container_assets": {},
  "visibility": "public",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "version",
        "format": "text",
        "value": "package"
      },
      {
        "path": "pyproject.toml",
        "format": "toml",
        "value": "package",
        "field": "project.version",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "value": "package",
        "package": "inverter-control",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "inverter-control-*.tar.gz",
        "format": "tar-text",
        "value": "package",
        "member": "inverter-control/version"
      },
      {
        "path": "inverter-control-*.tar.gz",
        "format": "tar-toml",
        "value": "package",
        "member": "inverter-control/pyproject.toml",
        "field": "project.version",
        "ecosystem": "pep440"
      }
    ],
    "toolkit_revision": "ba7c4ece1188974df04799158e35603e968a4bac"
  },
  "single_entry_ci": true
}
