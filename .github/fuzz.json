{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "tariff",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_tariff.py",
        "-max_len=100001"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/tariff",
      "instrumentation": [
        {
          "module": "inverter_control.tariff",
          "functions": [
            "_read_stream",
            "validate_tariff"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    ".github/requirements-fuzz.in",
    "fuzz",
    "inverter_control",
    "pyproject.toml",
    "requirements.txt",
    "uv.lock"
  ]
}
