#!/bin/sh
exec 2>&1
cd /data/inverter-control || exit 1
PYTHON="$(python3 -I -B ./runtime_python.py)" || exit $?
# Endpoint configuration is loaded by the process from persistent setupOptions.
# Unbuffered output makes failed pushes and configuration errors visible at once.
exec "$PYTHON" -u inverter_control/log_forwarder.py
