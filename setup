#!/bin/bash

# inverter-control SetupHelper compatible setup script
# Grid-zero feed-in control for Victron inverters with Home Assistant integration

#### following line incorporates SetupHelper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources

installDir="/data/inverter-control"

#### running manually - prompt for input (interactive terminals only).
# Headless callers (MCP tools, CI, PackageManager without env) must never
# land in standardActionPrompt: it reads stdin and blocks forever on a
# non-interactive channel. 2026-08-24: such a hang outlived its SSH session,
# left a zombie bash, and the half-done install had already swapped the
# package directory. Refuse cleanly instead.
if [ "$scriptAction" == 'NONE' ] && ! [ -t 0 ]; then
    echo "ERROR: scriptAction is not set and stdin is not a TTY - refusing to prompt." >&2
    echo "Install via PackageManager, or run non-interactively:" >&2
    echo "  $0 install auto" >&2
    exit 1
fi
if [ "$scriptAction" == 'NONE' ]; then
    standardActionPrompt
fi

#### install
if [ "$scriptAction" == 'INSTALL' ]; then
    logMessage "Installing $packageName"

    # Optional PackageManager setting. Absence defers to local_config.py;
    # presence explicitly overrides that flag and survives package upgrades.
    backupOption="/data/setupOptions/$packageName/use_grid_submeter_as_backup"
    if [ -f "$backupOption" ]; then
        backupValue=$(tr '[:upper:]' '[:lower:]' < "$backupOption" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        case "$backupValue" in
            true|false|1|0) ;;
            *) echo "ERROR: $backupOption must contain true or false" >&2; exit 1 ;;
        esac
    fi
    if [ -t 0 ] && [ "$userInteraction" = true ]; then
        echo "Use the configured grid submeter when the primary meter is unavailable?"
        read -r -p "Enter true/false, or leave blank to keep the current setting: " backupAnswer
        case "$backupAnswer" in
            true|false)
                mkdir -p "$(dirname "$backupOption")" || exit $?
                printf '%s\n' "$backupAnswer" > "$backupOption" || exit $?
                ;;
            '') ;;
            *) echo "ERROR: expected true or false" >&2; exit 1 ;;
        esac
    fi

    # Use one installer for PackageManager, local updates and webhook releases.
    # The package directory may be the source; update.sh handles that safely.
    mkdir -p "$installDir"
    if [ -f "/data/setupOptions/$packageName/local_config.py" ]; then
        cp "/data/setupOptions/$packageName/local_config.py" "$installDir/" || exit $?
        logMessage "Using local_config.py from setupOptions"
    fi
    sh "$scriptDir/update.sh" "$installDir" || exit $?

fi

#### uninstall
if [ "$scriptAction" == 'UNINSTALL' ]; then
    logMessage "Uninstalling $packageName"

    # Stop and retire supervisors before unlinking their service directories.
    for name in watchdog log-forwarder inverter-control; do
        svc -dx "/service/$name" "/service/$name/log" 2>/dev/null || true
        rm -f "/service/$name"
    done
    if [ -f /data/rc.local ]; then
        sed -i '/# === inverter-control.*persistence ===/,/# === end inverter-control ===/d' /data/rc.local
    fi
    # Retain configuration, certificates and persisted data for explicit cleanup.
    removeDbusSettings \
        "/Settings/InverterControl/TouExpensiveStartHour" \
        "/Settings/InverterControl/TouExpensiveEndHour"
fi

# Finish. NOTE: deliberately no INSTALL_SERVICES here — services are installed
# by the INSTALL branch above (persistent /data layout, not SetupHelper's
# tmpfs /service copy)
endScript
